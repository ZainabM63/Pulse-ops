{
  "version": 2,
  "framework": null,
  "installCommand": "composer install --no-dev --no-scripts --optimize-autoloader",
  "buildCommand": "php artisan migrate --force || true",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}